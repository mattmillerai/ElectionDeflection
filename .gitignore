# Xcode
*.xcuserstate
*.xcuserdatad/
xcuserdata/
project.xcworkspace/xcuserdata/
DerivedData/
build/
*.pbxuser
*.mode1v3
*.mode2v3
*.perspectivev3
!default.pbxuser
!default.mode1v3
!default.mode2v3
!default.perspectivev3

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Python (CI helper scripts under .github/scripts/)
__pycache__/
*.pyc

# AI Tools
.claude/
.cursor/

# Build artifacts
*.ipa
*.dSYM.zip
*.dSYM

# Swift Package Manager
.swiftpm/

# Training data (JSON/model/txt files contain real message content).
# The raw files stay OUT of git; an encrypted bundle is committed instead
# (TrainingData/training_data.enc — key in 1Password, see scripts/*-training-data.sh).
# training_data_v1.json and synthetic_enrichment.json were force-added earlier
# and stay tracked despite this rule.
TrainingData/*.json
TrainingData/*.mlmodel
TrainingData/*.mlmodelc
TrainingData/*.txt
!TrainingData/training_data.enc

# BMAD framework (dev tooling only)
_bmad/
_bmad-output/

# Environment / secrets
.dev.vars
Secrets.plist
Secrets.xcconfig

# Wrangler (Cloudflare Workers local cache)
.wrangler/

# Node modules (Worker dependencies)
node_modules/

# Code signing
*.p12
*.mobileprovision
*.cer

# Ruby/fastlane — resolve on the runner

# Feedback pipeline — harvested user texts & Slack tokens must never be committed
tools/feedback/*.jsonl
tools/feedback/*_report.md
slack_token
*.slack_token
